# Copier ce fichier en .env.local puis remplir les valeurs.
# Les deux valeurs Supabase sont publiques par conception : la sécurité repose sur les
# règles RLS de la base. Ne jamais mettre ici la clé « service_role » / « secret ».

# Supabase > Project Settings > API : « Project URL »
VITE_SUPABASE_URL=https://votre-projet.supabase.co
# Supabase > Project Settings > API : clé « anon » ou « publishable »
VITE_SUPABASE_PUBLISHABLE_KEY=

# Sous-dossier de publication. « / » en local, « /popote/ » sur GitHub Pages.
VITE_BASE_PATH=/
